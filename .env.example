# Base URLs of the collaborating modules. Point these at the real services.
SCAM_API_URL=http://127.0.0.1:8001/predict
URL_API_URL=http://127.0.0.1:8002/analyze-url

# How long a single upstream call may take before it is treated as a timeout.
REQUEST_TIMEOUT_SECONDS=4.0

# Extra attempts after the first one for timeouts and 5xx responses.
MAX_RETRIES=1

# Comma separated list. Use * only for local development.
CORS_ORIGINS=*

# Optional override for the risk rule set.
# RISK_CONFIG_PATH=config/risk_config.json
